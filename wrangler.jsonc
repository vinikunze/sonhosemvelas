{
  // Sonhos em Velas: Worker com arquivos estáticos (public/), banco D1 e fotos no KV
  "name": "sonhosemvelas",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Só estas rotas passam pelo código; o resto (CSS, JS, imagens) sai direto como arquivo
    "run_worker_first": ["/", "/catalogo", "/api/*", "/p/*", "/fotos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonhosemvelas",
      "database_id": "309a0bd1-ca10-43a5-9e00-93a9f2b3f6bc",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "FOTOS", "id": "6840fe1d9c3e49e88a9ef5bb1b9bfa61" }
  ],
  "observability": { "enabled": true }
}
